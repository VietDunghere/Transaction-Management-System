# ========================================
# Application
# ========================================
APP_NAME="Transaction Management System"
APP_ENV=development
DEBUG=true

# ========================================
# Database — MySQL 8.0 on tms_local
# Password special chars must be URL-encoded (e.g. @ -> %40)
# ========================================
DATABASE_URL=mysql+pymysql://root:1234%40%40@localhost:3306/tms_local?charset=utf8mb4

# ========================================
# JWT Authentication
# ========================================
JWT_SECRET_KEY=change-me-in-production-very-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# Fraud Detection Model
# ========================================
FRAUD_MODEL_PATH=./ml_models/fraud_rf_v3.pkl
FRAUD_REJECT_THRESHOLD=0.45
FRAUD_REVIEW_THRESHOLD=0.05
FRAUD_MODEL_VERSION=rf_v3_regularized

# ========================================
# API
# ========================================
API_PREFIX=/api/v1
CORS_ORIGINS=
